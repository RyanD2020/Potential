# Copy this file to .env and fill in whichever key(s) you have, or just
# paste them into the sidebar of the running app instead - either works.
# You only need ONE of these for the app to work.
#
# If you use this file, you'll need to load it yourself (e.g. `export
# $(cat .env | xargs)` before running `streamlit run app.py`, or with a
# tool like python-dotenv) since the app reads os.environ directly.
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-openai-key-here
GOOGLE_API_KEY=your-google-ai-studio-key-here
